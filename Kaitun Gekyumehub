-- Helper function to create styled labels
local function CreateLabel(text, color, size, isBold)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, size or 20)
    label.BackgroundTransparency = 1
    label.Font = isBold and Enum.Font.SourceSansBold or Enum.Font.SourceSansSemibold
    label.TextSize = size and (size - 4) or 16
    label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    label.Text = text
    label.Parent = TextContainer
    return label
end

