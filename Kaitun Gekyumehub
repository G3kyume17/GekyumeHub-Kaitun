-- Make the toggle button draggable
local dragging, dragInput, dragStart, startPos
ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleButton.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

ToggleButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        ToggleButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- 3. Toggle Logic
local function ToggleKaitun()
    KaitunEnabled = not KaitunEnabled
    
    if KaitunEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 120, 70) -- Green when ON
        ToggleButton.Text = "KAITUN • ON"
        Background.Visible = true
        RunService:Set3dRenderingEnabled(false)
        StartTime = os.time() -- Reset session timer
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 50, 50) -- Red when OFF
        ToggleButton.Text = "KAITUN • OFF"
        Background.Visible = false
        RunService:Set3dRenderingEnabled(true)
    end
end

-- Hook up the toggle button, checking dragging so it doesn't click when you move it
ToggleButton.MouseButton1Click:Connect(function()
    ToggleKaitun()
end)

-- 4. Format Time Helper
local function FormatTime(seconds)
    local hrs = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    return string.format("%02d:%02d:%02d", hrs, mins, secs)
end

-- 5. Helper function to find stat values dynamically across different folders
local function FindStat(name)
    -- Look in leaderstats first
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local stat = leaderstats:FindFirstChild(name)
        if stat then return stat.Value end
    end
    
    -- Fallback to PlayerData or other common nested folders
    local playerData = LocalPlayer:FindFirstChild("PlayerData") or LocalPlayer:FindFirstChild("Data")
    if playerData then
        local stat = playerData:FindFirstChild(name, true) -- Recursive search
        if stat and stat:IsA("ValueBase") then return stat.Value end
    end
    
    return nil
end

-- 6. Live UI Stats Updater Loop
task.spawn(function()
    local lastTime = os.clock()
    local frameCount = 0
    local fps = 60

    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local currentTime = os.clock()
        if currentTime - lastTime >= 1 then
            fps = frameCount
            frameCount = 0
            lastTime = currentTime
        end
    end)

    while task.wait(0.5) do
        if KaitunEnabled and not ScreenHidden then
            -- Update Session & FPS
            local elapsed = os.time() - StartTime
            SessionLabel.Text = string.format("SESSION %s • %d FPS", FormatTime(elapsed), fps)
            
            -- Track Live Game Stats dynamically
            local money = FindStat("Money") or FindStat("Coins") or FindStat("Yen") or 0
            local slots = FindStat("Slots") or FindStat("Equipped") or 0
            MoneyLabel.Text = string.format("MONEY $%s  SLOTS %s", tostring(money), tostring(slots))
            
            local gems = FindStat("Gems") or FindStat("Diamonds") or 0
            local traitItems = FindStat("TraitItems") or FindStat("Trait Items") or FindStat("Trait Crystals") or 0
            GemsLabel.Text = string.format("TRAIT ITEMS %s  GEMS %s", tostring(traitItems), tostring(gems))
            
            local luck = FindStat("Luck") or 1
            local bestDice = FindStat("BestDice") or FindStat("Best Dice") or "Unknown"
            DiceLabel.Text = string.format("BEST DICE %s • Luck %s", tostring(bestDice), tostring(luck))
            
            local floor = FindStat("Floor") or FindStat("CurrentFloor") or 0
            local runCount = FindStat("Run") or FindStat("Runs") or 0
            local towerName = FindStat("Tower") or FindStat("CurrentTower") or "None"
            TowerLabel.Text = string.format("TOWER %s • Run %s • Floor %s", tostring(towerName), tostring(runCount), tostring(floor))
        end
    end
end)

