end)

-- Dynamic Stat Reader
local function getVal(key, defaultVal)
    local rep = game:GetService("ReplicatedStorage")
    local attr = p:GetAttribute(key)
    if attr ~= nil then return attr end
    
    local leader = p:FindFirstChild("leaderstats")
    if leader and leader:FindFirstChild(key) then return leader[key].Value end
    
    return defaultVal
end

-- Live Loop
