-- Helper function for minimal stat cards
local function createStatRow(labelName, defaultVal, valColor)
    local row = Instance.new("Frame", statsList)
    row.Size = UDim2.new(1, 0, 0, 32)
    row.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
    row.BorderSizePixel = 0
    
    local rCorner = Instance.new("UICorner", row)
    rCorner.CornerRadius = UDim.new(0, 8)
    
    local tag = Instance.new("TextLabel", row)
    tag.Size, tag.Position = UDim2.new(0.4, 0, 1, 0), UDim2.new(0, 12, 0, 0)
    tag.Text, tag.Font, tag.TextSize = string.upper(labelName), Enum.Font.GothamBold, 11
    tag.TextColor3, tag.TextXAlignment, tag.BackgroundTransparency = Color3.fromRGB(140, 140, 170), Enum.TextXAlignment.Left, 1
    
    local val = Instance.new("TextLabel", row)
    val.Size, val.Position = UDim2.new(0.55, 0, 1, 0), UDim2.new(0.42, 0, 0, 0)
    val.Text, val.Font, val.TextSize = defaultVal, Enum.Font.GothamBold, 12
    val.TextColor3, val.TextXAlignment, val.BackgroundTransparency = valColor or Color3.fromRGB(255, 255, 255), Enum.TextXAlignment.Right, 1
    
    return val
end

