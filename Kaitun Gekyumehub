-- Advanced Game Data Scanner
local function getGameStat(keywords, defaultVal)
    local searchLocations = {
        p:FindFirstChild("leaderstats"),
        p:FindFirstChild("PlayerData"),
        p:FindFirstChild("Data"),
        p:FindFirstChild("PlayerGui")
    }
    
    for _, location in ipairs(searchLocations) do
        if location then
            for _, descendant in ipairs(location:GetDescendants()) do
                for _, key in ipairs(keywords) do
                    if string.find(string.lower(descendant.Name), string.lower(key)) then
                        if descendant:IsA("ValueBase") and descendant.Value ~= nil then
                            return descendant.Value
                        elseif descendant:IsA("TextLabel") and descendant.Text ~= "" then
                            return descendant.Text
                        end
                    end
                end
            end
        end
    end
    return defaultVal
end

-- Live Update Loop
task.spawn(function()
    while task.wait(0.5) do
        if on and not hide then
            local s = os.time() - start
            l_ses.Text = string.format("SESSION %02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)
            
            local money = getGameStat({"money", "yen", "cash", "coins"}, "0")
            local slots = getGameStat({"slots", "equippedslots", "maxslots"}, "0")
            l_mon.Text = string.format("MONEY $%s  SLOTS %s", tostring(money), tostring(slots))
            
            local gems = getGameStat({"gems", "diamonds"}, "0")
            local items = getGameStat({"traititems", "traits", "items"}, "0")
            l_gem.Text = string.format("TRAIT ITEMS %s  GEMS %s", tostring(items), tostring(gems))
            
            local dice = getGameStat({"bestdice", "dice", "equippeddice"}, "None")
            local luck = getGameStat({"luck", "multiplier"}, "1")
            l_dic.Text = string.format("BEST DICE %s • Luck %s", tostring(dice), tostring(luck))
            
            local unit = getGameStat({"bestunit", "highestincome", "unit"}, "None")
            l_unit.Text = string.format("HIGHEST INCOME UNIT: %s", tostring(unit))
            
            local tower = getGameStat({"tower", "currenttower"}, "None")
            local run = getGameStat({"run", "runs"}, "0")
            local floor = getGameStat({"floor", "currentfloor"}, "0")
            l_tow.Text = string.format("TOWER %s • Run %s • Floor %s", tostring(tower), tostring(run), tostring(floor))
        end
    end
end)

