-- Draggable logic
local drag, dStart, sPos
btn.InputBegan:Connect(function(i) 
    if i.UserInputType == Enum.UserInputType.MouseButton1 then drag, dStart, sPos = true, i.Position, btn.Position end 
end)
uis.InputChanged:Connect(function(i) 
    if drag and i.UserInputType == Enum.UserInputType.MouseMovement then 
        btn.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + (i.Position.X - dStart.X), sPos.Y.Scale, sPos.Y.Offset + (i.Position.Y - dStart.Y)) 
    end 
end)
uis.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)

